# Secrets / local settings (WANDB_API_KEY etc.) — never commit
.env

# Benchmark outputs — everything goes to W&B, nothing is tracked in git.
results/*
!results/.gitkeep

# Local W&B run cache
wandb/

# Datasets fetched by bench/get_sharegpt.sh (multi-hundred-MB JSON)
datasets/

# Python
__pycache__/
*.pyc
