# Copy to .env (which is git-ignored) and fill in. run.sh / run_all.sh auto-load it.
# On the cloud box:  cp .env.example .env  && edit.

# Weights & Biases (results durability). Get a key at https://wandb.ai/authorize
WANDB_API_KEY=
WANDB_PROJECT=aiand-kimik3-mxfp4
# WANDB_ENTITY=your-team        # optional

# Optional overrides
# PORT=8888
# DOWNLOAD_DIR=/workspace/models
# DATASET=sharegpt              # sharegpt (default) | random
# SHAREGPT_PATH=/workspace/datasets/ShareGPT_V3_unfiltered_cleaned_split.json
# DRAFT_MODEL=Inferact/Kimi-K3-DSpark    # DSpark speculative-decoding draft
# WANDB=0            # set to disable W&B sync entirely
